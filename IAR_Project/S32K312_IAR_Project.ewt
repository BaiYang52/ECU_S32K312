        <settings>
            
            
            <name>RuntimeChecking</name>
            
            
            <archiveVersion>0</archiveVersion>
            
            
            <data>
                
                
                <version>2</version>
                
                
                <wantNonLocal>1</wantNonLocal>
                
                
                <debug>1</debug>
                
                
                <option>
                    
                    
                    <name>GenRtcDebugHeap</name>
                    
                    
                    <state>0</state>
                    
                
                </option>
                
                
